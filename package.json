{
  "name": "yily-sdk-js",
  "version": "0.1.0",
  "description": "TypeScript and JavaScript SDK for reading configuration variables and secrets from Yily",
  "license": "MIT",
  "author": "Yannick KOUAKOU",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yannick2009/yily-sdk-js.git"
  },
  "homepage": "https://github.com/yannick2009/yily-sdk-js#readme",
  "bugs": {
    "url": "https://github.com/yannick2009/yily-sdk-js/issues"
  },
  "keywords": [
    "yily",
    "configuration",
    "secrets",
    "sdk",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
